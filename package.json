{
  "name": "france-alert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build && npm run build:worker",
    "build:worker": "tsc -p tsconfig.worker.json && node scripts/postbuild-worker.mjs",
    "start": "node server.js",
    "ingest": "node --env-file-if-exists=.env dist/worker/ingest.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "//": "Pas de `postinstall: prisma generate` : sur cPanel (Node Selector), node_modules vit dans le virtualenv et npm exécute les scripts DEPUIS ce dossier, où prisma/schema.prisma n'existe pas — l'install échouait. `dev` et `build` génèrent le client, ce qui couvre tous les cas.",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.0.0",
    "next": "15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
