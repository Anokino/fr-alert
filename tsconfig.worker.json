/*
 * Compilation du worker d'ingestion — chaîne SÉPARÉE de celle du web.
 *
 * Le web est bundlé par Next ; le worker, lui, est lancé directement par `node` depuis cron.
 * Il lui faut donc du JavaScript exécutable tel quel, ce que produit `tsc` ici.
 *
 * Deux choix expliqués, à ne pas défaire :
 *  - **CommonJS** : en ESM, Node exige l'extension `.js` sur chaque import relatif, ce que
 *    le reste du code (écrit pour le bundler Next) n'a pas. Compiler en CJS laisse les
 *    imports sans extension se résoudre normalement. Comme `package.json` déclare
 *    `"type": "module"`, `scripts/postbuild-worker.mjs` dépose un `dist/package.json` avec
 *    `"type": "commonjs"` pour que Node interprète `dist/` correctement.
 *  - **Pas d'alias `@/`** : `tsc` ne réécrit pas les chemins des alias à l'émission. C'est
 *    pourquoi `src/core/**` et `src/lib/db.ts` n'utilisent que des imports relatifs.
 */
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["src/worker/**/*.ts", "src/core/**/*.ts", "src/lib/db.ts"]
}
