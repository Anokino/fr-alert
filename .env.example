# ─────────────────────────────── Base de données ───────────────────────────────
# SQLite en dev ET en prod (migrable MySQL/Postgres si un jour le volume l'exige).
# Le fichier est partagé par les DEUX exécutions : le web (Passenger) et le worker
# d'ingestion (cron). En prod, mettre un chemin ABSOLU — le cron ne démarre pas
# forcément depuis le dossier de l'app, et un chemin relatif créerait une seconde base
# silencieusement vide.
#   dev  : file:./dev.db
#   prod : file:/home/<utilisateur>/fr-alert/prod.db
DATABASE_URL="file:./dev.db"

# ─────────────────────────────── Ingestion ───────────────────────────────
# FA_INGEST=1 déclare qu'un worker (cron) alimente l'instantané des sources nationales.
# Le web cesse alors d'interroger lui-même les APIs amont : il sert l'instantané, et si
# celui-ci manque il le dit franchement au lieu d'afficher un faux « rien à signaler ».
#
# ⚠️ À n'activer QU'UNE FOIS le cron en place et une première ingestion réussie
# (`npm run ingest -- --force`). Laissé vide, le web se débrouille seul comme avant :
# plus lent, mais autonome. C'est l'interrupteur du passage en mode « deux exécutions ».
FA_INGEST=""

# ─────────────────────────────── Clés OPTIONNELLES ───────────────────────────────
# L'app fonctionne sans elles ; les modules concernés se dégradent proprement.
# Elles ne sont lues que côté serveur (web + worker), jamais exposées au client.

# NASA FIRMS — feux actifs. Clé gratuite : https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=""

# Météo-France — un seul token couvre Vigilance ET Météo des forêts.
# En-tête `apikey:` (le Bearer est refusé). Prendre l'API key longue durée, pas l'OAuth2 1 h.
METEOFRANCE_TOKEN=""
